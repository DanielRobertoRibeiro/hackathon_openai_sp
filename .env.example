# OpenAI is optional. Without a key, Maestro uses the deterministic baseline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
MAESTRO_AGENT_MODE=auto

# Local single-process persistence for the hackathon MVP.
MAESTRO_STORAGE_FILE=.data/maestro.json

# Knowledge adapter: memory | filesystem | mcp
KNOWLEDGE_ADAPTER=memory
OBSIDIAN_VAULT_PATH=./obsidian-vault
OBSIDIAN_ALLOWED_PREFIXES=01 Projeto Maestro,15 Decisoes,16 Riscos e bloqueios,17 Evidencias,18 Handoffs

# Reserved for the future MCP transport implementation.
OBSIDIAN_MCP_SERVER=
OBSIDIAN_MCP_TOKEN=
